# انسخ هالملف باسم .env وعبّي القيم بإيدك. ولا مرة تلصق توكن بالمحادثة.
# هالبيئة خاصة بالميديا باير: قاعدة بيانات ومنفذ ومفاتيح لحالها.

# ── الأساس ──
APP_URL=http://localhost:3140
DATABASE_URL=postgresql://mediabuyer:mediabuyer_local_only@127.0.0.1:5450/mediabuyer
TZ=Asia/Amman
# 32 بايت عشوائي (base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
AUTH_SECRET=
# المفاتيح اللي بتنحفظ من الموقع (الإعدادات ← الربط، D62): 32 بايت base64 أو 64 خانة hex — openssl rand -base64 32. بلاه الأسرار ما بتنحفظ من الموقع ومفاتيح Coolify بتضل شغّالة
SECRETS_MASTER_KEY=
# 1 = بيانات تجريبية بكل الشاشات (لحد ما يجهز الربط الحقيقي)
MOCK_MODE=1
# 0 = بدون دخول على جهاز التطوير بس (بيتجاهلها الإنتاج دايماً).
AUTH_REQUIRED=0
# حساب المالك من البذور (اختياري) — أو أول دخول بيعمله
SEED_OWNER_EMAIL=
# على السيرفر: بس هالإيميل بيقدر يعمل حساب المالك أول مرة
OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ── فيسبوك (P0.4) ──
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_API_VERSION=v24.0
META_SYSTEM_USER_TOKEN=
# dry_run (افتراضي): بيسجّل شو كان رح ينبعت لميتا وما بيبعت. live: بس بعد ما ينجح فحص المرحلة 2 على حساب تجريبي
META_WRITE_MODE=dry_run
# Live writes need BOTH META_WRITE_MODE=live AND META_LIVE_VERIFIED=1 (the owner's own «yes, write for real»). The first time, the token must see ONLY the TEST ad account (docs/LIVE_CHECKS.md). Without it a live request is refused with an Arabic error, never run quietly as a dry-run.
META_LIVE_VERIFIED=
# The pixel conversion events go to (default: the first one synced from Meta), and Meta's Test Events code for the first real try
META_DATASET_ID=
CAPI_TEST_EVENT_CODE=
# Conversion events to Meta from THIS site: off unless 1. The OMS is the only sender (owner, 17/11) — two senders on one pixel double-count. Leave empty.
CAPI_SEND=

# ── Drive (P0.6) ──
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_PRODUCTS_FOLDER_ID=
# the studio's own Drive tree «Zakiai» — the owner shares it with the service account (Viewer); read only
DRIVE_STUDIO_FOLDER_ID=
# the owner's «Zaki Production» tree (06_الفيديوهات النهائية · 03_السيناريوهات · the register) — shared with the service account, READ ONLY
DRIVE_PRODUCTION_FOLDER_ID=
# optional: his register's file id (a CSV or a Sheet) when its name does not say «سجل» / «register»
DRIVE_REGISTER_FILE_ID=
REGISTRY_SHEET_ID=

# ── تيليجرام (P0.7) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
# سر بيبعته تيليجرام مع كل رسالة (setWebhook secret_token) — بيتولّد بـ Coolify
TELEGRAM_WEBHOOK_SECRET=
# هيرمز (طلبات الفيديوهات): إما API (POST {HERMES_BASE_URL}/requests بـ Bearer) أو شات تيليجرام لحاله (مش شات المالك)
HERMES_BASE_URL=
HERMES_TOKEN=
TELEGRAM_HERMES_CHAT_ID=

# ── الموديلات (P0.8) — المحلي هو Ollama على جهازك ──
INTERNAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
INTERNAL_MODEL_KEY=
INTERNAL_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
# المساعد الذكي (Claude API): المفتاح من لوحة Anthropic — بـ Coolify بس، مش بالريبو ولا بالشات. ANTHROPIC_API_KEY أو CLAUDE_API_KEY (أي واحد منهم).
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
# موديل المساعد (الافتراضي claude-opus-5-5؛ أرخص وأسرع: claude-sonnet-5-5). السقف اليومي: الإعدادات ← الوكلاء (M12، الافتراضي 3$).
ASSISTANT_MODEL=
# ط§ظ„ظ…ط³ط§ط¹ط¯ ط¹ظ„ظ‰ ظ…ظˆط¯ظٹظ„ ظ…طھظˆط§ظپظ‚ ظ…ط¹ OpenAI (ظ…طھظ„ ط§ظ„ظ„ظٹ ط¨طµظپط­ط§طھ ط§ظ„ظ‡ط¨ظˆط·): ط§ظ„ط¹ظ†ظˆط§ظ† ط¨ظٹظ†طھظ‡ظٹ ط¨ظ€ /v1طŒ ظˆط§ظ„ط«ظ„ط§ط«ط© ظ…ط¹ ASSISTANT_MODEL â€” ط¨ظ„ط§ظ‡ظ… ط¨ظٹط¶ظ„ ط¹ظ„ظ‰ Claude.
# ASSISTANT_USD_PER_1K (ط§ط®طھظٹط§ط±ظٹ): ط³ط¹ط± ط§ظ„ط£ظ„ظپ طھظˆظƒظ† ظ„ظ„ط³ظ‚ظپ ط§ظ„ظٹظˆظ…ظٹط› ظپط§ط¶ظٹ = ط¨ظٹطھط­ط³ط¨ ط¨ط³ط¹ط± ط£ط؛ظ„ظ‰ Claude.
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_USD_PER_1K=
GLM_API_KEY=
GLM_BASE_URL=
KIMI_API_KEY=
GEMINI_API_KEY=
# internal_only = ولا موديل خارجي لأي وكيل — والمساعد (Claude) خارجي، فبيضل مقفول. لتشغيله: PRIVACY_MODE=off
PRIVACY_MODE=internal_only
# مزوّد خارجي اختياري متوافق مع OpenAI (GLM · Kimi · Gemini · …)
EXTERNAL_MODEL_BASE_URL=
EXTERNAL_MODEL_KEY=
EXTERNAL_MODEL_NAME=
EXTERNAL_MODEL_USD_PER_1K=0.002

# ── الأنظمة (P0.3) ──
OMS_BASE_URL=
OMS_TOKEN=
REPLIES_BASE_URL=
REPLIES_TOKEN=
STUDIO_BASE_URL=
STUDIO_TOKEN=

# ── التواقيع ──
WEBHOOK_SECRET_OMS=
WEBHOOK_SECRET_REPLIES=
WEBHOOK_SECRET_STUDIO=
# حدث «اوقف» الموقّع من الـ OMS (POST /api/inbound/oms، HMAC + نافذة 5 دقائق، D63) — إيقاف بس
OMS_EVENT_SECRET=

# وين بتنحفظ نسخ الفيديوهات والأغلفة (على السيرفر: قرص دائم)
STORAGE_DIR=

# Running workflow steps from the site (D35): n8n (https base + the secret that signs what we send) and the lists of what may be called.
# Nothing outside these lists is ever called. N8N_ALLOWED_PATHS = webhook names (comma separated); STEP_HTTP_ALLOW = https hosts (api.example.com or *.example.com).
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_ALLOWED_PATHS=
STEP_HTTP_ALLOW=
# Hosts the studio may send video links from (optional; empty = any public https host. An internal address is refused either way)
STUDIO_URL_ALLOW=

# Zaki Workspace (D41): its one-way door. A token made on its «الأتمتة» screen with tasks.write + tasks.read; the board is optional when the token sees only one.
WORKSPACE_BASE_URL=
WORKSPACE_API_TOKEN=
WORKSPACE_BOARD_ID=

# The site's own clock for workflows with a schedule (D44): 1 = the worker wakes them (Claude through the handoff queue, or the site's own steps). Leave empty while n8n is the clock.
SITE_SCHEDULER=
