# انسخ هالملف باسم .env وعبّي القيم بإيدك. ولا مرة تلصق توكن بالمحادثة.
# هالبيئة خاصة بالميديا باير: قاعدة بيانات ومنفذ ومفاتيح لحالها.

# ── الأساس ──
APP_URL=http://localhost:3140
DATABASE_URL=postgresql://mediabuyer:mediabuyer_local_only@127.0.0.1:5450/mediabuyer
TZ=Asia/Amman
# 32 بايت عشوائي (base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
AUTH_SECRET=
# 1 = بيانات تجريبية بكل الشاشات (لحد ما يجهز الربط الحقيقي)
MOCK_MODE=1
# 0 = بدون دخول على جهاز التطوير بس (بيتجاهلها الإنتاج دايماً).
AUTH_REQUIRED=0
# حساب المالك من البذور (اختياري) — أو أول دخول بيعمله
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ── فيسبوك (P0.4) ──
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_API_VERSION=v24.0
META_SYSTEM_USER_TOKEN=

# ── Drive (P0.6) ──
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_PRODUCTS_FOLDER_ID=
REGISTRY_SHEET_ID=

# ── تيليجرام (P0.7) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# ── الموديلات (P0.8) — المحلي هو Ollama على جهازك ──
INTERNAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
INTERNAL_MODEL_KEY=
INTERNAL_MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M
CLAUDE_API_KEY=
GLM_API_KEY=
GLM_BASE_URL=
KIMI_API_KEY=
GEMINI_API_KEY=
PRIVACY_MODE=internal_only
# مزوّد خارجي اختياري متوافق مع OpenAI (GLM · Kimi · Gemini · …)
EXTERNAL_MODEL_BASE_URL=
EXTERNAL_MODEL_KEY=
EXTERNAL_MODEL_NAME=
EXTERNAL_MODEL_USD_PER_1K=0.002

# ── الأنظمة (P0.3) ──
OMS_BASE_URL=
OMS_TOKEN=
REPLIES_BASE_URL=
REPLIES_TOKEN=
STUDIO_BASE_URL=
STUDIO_TOKEN=

# ── التواقيع ──
WEBHOOK_SECRET_OMS=
WEBHOOK_SECRET_REPLIES=
WEBHOOK_SECRET_STUDIO=
