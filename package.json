{
  "name": "zaki-mediabuyer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "effect": "^3.22.5",
    "deepmerge-ts": "^8.0.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "next dev -p 3140",
    "build": "prisma generate && next build",
    "start": "next start -p 3140",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "themes:css": "tsx scripts/build-themes-css.mjs",
    "n8n:build": "tsx scripts/build-n8n.ts",
    "ui:baseline": "tsx scripts/ui-baseline.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx --env-file=.env worker/index.ts",
    "demo:pipeline": "tsx --env-file=.env scripts/demo-pipeline.ts",
    "demo:launch": "tsx --env-file=.env scripts/demo-launch.ts",
    "demo:capi": "tsx --env-file=.env scripts/demo-capi.ts",
    "demo:phase5": "tsx --env-file=.env scripts/demo-phase5.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/db-backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env scripts/db-restore.ts",
    "check:backup": "tsx --env-file=.env scripts/backup-restore-check.ts",
    "check:full": "tsx --env-file=.env scripts/full-check.ts",
    "demo:agents": "tsx --env-file=.env scripts/demo-agents.ts",
    "demo:mcp": "tsx --env-file=.env scripts/demo-mcp.ts",
    "demo:secrets": "tsx --env-file=.env scripts/demo-secrets.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@firebase/app": "^0.16.7",
    "@firebase/messaging": "^0.13.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.56.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "driver.js": "^1.10.2",
    "exceljs": "^4.4.0",
    "jose": "^5.9.0",
    "lucide-react": "^0.441.0",
    "next": "^16.4.6",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "postcss": "^8.5.30",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
