{
  "name": "zaki-mediabuyer",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "^8.5.30"
  },
  "scripts": {
    "dev": "next dev -p 3140",
    "build": "prisma generate && next build",
    "start": "next start -p 3140",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "themes:css": "tsx scripts/build-themes-css.mjs",
    "decor:css": "node scripts/build-decor-css.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx --env-file=.env worker/index.ts",
    "demo:pipeline": "tsx --env-file=.env scripts/demo-pipeline.ts",
    "demo:launch": "tsx --env-file=.env scripts/demo-launch.ts",
    "demo:capi": "tsx --env-file=.env scripts/demo-capi.ts",
    "demo:phase5": "tsx --env-file=.env scripts/demo-phase5.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/db-backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env scripts/db-restore.ts",
    "check:backup": "tsx --env-file=.env scripts/backup-restore-check.ts",
    "check:full": "tsx --env-file=.env scripts/full-check.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tanstack/react-query": "^5.56.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "driver.js": "^1.10.2",
    "exceljs": "^4.4.0",
    "jose": "^5.9.0",
    "lucide-react": "^0.441.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "postcss": "^8.5.30",
    "prisma": "^5.20.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
