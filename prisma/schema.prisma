// Zaki Media Buyer — Phase 1 data model (spec 13.5). Additive only: later phases add tables, never reshape these.
// Every table: id · createdAt · updatedAt. Money is Decimal. No customer name / phone / address field anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── people, audit, settings ─────────────────────────────

enum Role {
  OWNER
  ADS_MANAGER
  ANALYST
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  /// bumped to sign every session of this person out
  sessionVer   Int       @default(1)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Who did what to what: a person, a rule or an agent. Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // user | rule | agent | system
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// A setting with its history: every change is a new version, and any version can be restored.
model Setting {
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  SettingVersion[]
}

model SettingVersion {
  id        String   @id @default(cuid())
  key       String
  version   Int
  value     Json
  changedBy String?
  createdAt DateTime @default(now())
  setting   Setting  @relation(fields: [key], references: [key], onDelete: Cascade)

  @@unique([key, version])
}

// ───────────────────────────── Meta: connection and assets ─────────────────────────────

model MetaConnection {
  id        String    @id @default(cuid())
  userId    String?
  kind      String // system_user | login
  scopes    String[]
  tokenEnc  String
  expiresAt DateTime?
  status    String    @default("active") // active | expired | revoked
  checkedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AdAccount {
  id            String   @id @default(cuid())
  metaId        String   @unique // act_…
  name          String
  currency      String
  timezone      String
  status        String
  market        String? // SY · JO · …
  autonomyLevel Int      @default(1)
  dailyCap      Decimal? @db.Decimal(12, 2)
  monthlyCap    Decimal? @db.Decimal(12, 2)
  spendCapMeta  Decimal? @db.Decimal(12, 2)
  paymentStatus String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  campaigns     Campaign[]
}

model Page {
  id        String   @id @default(cuid())
  metaId    String   @unique
  name      String
  code      String? // SP · VP · AJ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dataset {
  id        String   @id @default(cuid())
  metaId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The rate-limit headers of every Meta call (business use case usage), for the dashboard counter.
model ApiUsage {
  id        String   @id @default(cuid())
  scope     String
  callCount Int
  cpuTime   Int
  totalTime Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────────── structure ─────────────────────────────

model Campaign {
  id            String    @id @default(cuid())
  metaId        String    @unique
  accountId     String
  account       AdAccount @relation(fields: [accountId], references: [id])
  name          String
  status        String
  objective     String?
  parsedMarket  String?
  productCode   String?
  parsedObjective String?
  stage         String?
  namingOk      Boolean   @default(false)
  /// how the product was found: name | alias | none
  productVia    String?
  budgetType    String? // CBO | ABO
  dailyBudget   Decimal?  @db.Decimal(12, 2)
  bidStrategy   String?
  spendCap      Decimal?  @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  adsets        AdSet[]
}

model AdSet {
  id                    String    @id @default(cuid())
  metaId                String    @unique
  campaignId            String
  campaign              Campaign  @relation(fields: [campaignId], references: [id])
  name                  String
  status                String
  audienceCode          String?
  pageCode              String?
  conceptId             String?
  optimizationGoal      String?
  dailyBudget           Decimal?  @db.Decimal(12, 2)
  learningStage         String?
  lastSignificantEditAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  ads                   Ad[]
}

model Ad {
  id            String   @id @default(cuid())
  metaId        String   @unique
  adSetId       String
  adSet         AdSet    @relation(fields: [adSetId], references: [id])
  name          String
  status        String
  creativeCode  String?
  hookCode      String?
  angleCode     String?
  lpCode        String?
  reviewStatus  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductAlias {
  id          String   @id @default(cuid())
  productCode String
  alias       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productCode, alias])
}

// ───────────────────────────── numbers and truth ─────────────────────────────

/// One row per object per day, archived forever (Meta deletes old detail). Re-pulling a day overwrites it.
model InsightDaily {
  id                 String   @id @default(cuid())
  level              String // account | campaign | adset | ad
  objectId           String // Meta id
  date               DateTime @db.Date
  spend              Decimal  @db.Decimal(12, 2)
  impressions        Int
  reach              Int
  frequency          Decimal  @db.Decimal(8, 4)
  linkClicks         Int
  outboundClicks     Int
  lpv                Int
  purchases          Int
  conversations      Int
  video3s            Int
  thruplays          Int
  p25                Int
  p50                Int
  p75                Int
  p95                Int
  p100               Int
  qualityRanking     String?
  engagementRanking  String?
  conversionRanking  String?
  /// the attribution window this row was pulled with — always explicit (spec 4)
  attributionSetting String
  source             String   @default("api") // api | import
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([level, objectId, date])
  @@index([date])
}

/// An OMS order and the ad it came from. No customer data: capiRef is an encrypted reference only CAPI code opens.
model AttributedOrder {
  id           String    @id @default(cuid())
  omsOrderId   String    @unique
  productCode  String
  market       String
  channel      String // website | whatsapp | messenger
  adId         String?
  adSetId      String?
  campaignId   String?
  adName       String?
  lpUrl        String?
  /// ad_id | naming | allocation | none
  method       String
  status       String
  createdAtOms DateTime
  confirmedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  returnedAt   DateTime?
  canceledAt   DateTime?
  orderValue   Decimal   @db.Decimal(12, 2)
  collected    Decimal?  @db.Decimal(12, 2)
  currency     String
  isFake       Boolean   @default(false)
  capiRef      String?
  matureAt     DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([adId])
  @@index([productCode, createdAtOms])
}

/// The computed truth (spec 6.2 / 6.3) per level per day — what the screens and the report read.
model TruthDaily {
  id                 String   @id @default(cuid())
  level              String // product | campaign | adset | ad
  objectId           String
  date               DateTime @db.Date
  spendWithFee       Decimal  @db.Decimal(12, 2)
  orders             Int
  matureOrders       Int
  confirmed          Int
  shipments          Int
  delivered          Int
  returned           Int
  costPerConfirmed   Decimal? @db.Decimal(12, 4)
  confirmRate        Decimal? @db.Decimal(8, 6)
  deliveryRate       Decimal? @db.Decimal(8, 6)
  returnRate         Decimal? @db.Decimal(8, 6)
  netCollected       Decimal  @db.Decimal(12, 2)
  lossLimit          Decimal? @db.Decimal(12, 4)
  scalingCeiling     Decimal? @db.Decimal(12, 4)
  profitAfterCosts   Decimal  @db.Decimal(12, 2)
  profitPerDelivered Decimal? @db.Decimal(12, 4)
  trueRoas           Decimal? @db.Decimal(10, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([level, objectId, date])
}

model UnattributedPool {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  campaignMetaId String
  spend     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignMetaId, date])
}

/// The numbers of a product for the calculator (spec 6.3). source: estimate until 50 shipments, then actual.
model ProductEconomics {
  id            String   @id @default(cuid())
  productCode   String   @unique
  name          String
  market        String
  price         Decimal  @db.Decimal(12, 2)
  unitCost      Decimal  @db.Decimal(12, 2)
  deliveryFee   Decimal  @db.Decimal(12, 2)
  returnFee     Decimal  @db.Decimal(12, 2)
  codFeePct     Decimal  @db.Decimal(6, 4)
  confirmCost   Decimal  @db.Decimal(12, 2)
  stockDays     Int?
  source        String   @default("estimate")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ───────────────────────────── jobs, alerts, reports, agents ─────────────────────────────

/// A scheduled job run. The unique (job, slot) row is the lock: a job never runs twice for the same slot.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  slot       String
  status     String // running | ok | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  stats      Json?

  @@unique([job, slot])
  @@index([job, startedAt])
}

model Alert {
  id        String    @id @default(cuid())
  kind      String
  tone      String // danger | warn | info
  text      String
  href      String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Report {
  id        String   @id @default(cuid())
  kind      String // morning | weekly | monthly
  forDate   DateTime @db.Date
  text      String
  sentAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, forDate])
}

/// Every model call: which agent, which provider, cost, and whether the privacy filter blocked it.
model AgentRun {
  id         String   @id @default(cuid())
  agent      String
  provider   String
  model      String
  ok         Boolean
  blocked    String?
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  costUsd    Decimal  @default(0) @db.Decimal(10, 4)
  ms         Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())

  @@index([agent, createdAt])
}

// ───────────────────────────── the content studio (docs/STUDIO_DATA_CONTRACT_AR.md) ─────────────────────────────

/// A token another system (the content studio) calls this one with. Only the sha256 is kept; the token is shown once.
model ApiToken {
  id          String    @id @default(cuid())
  name        String
  /// vp:read · vp:launch — never a scope that approves spend
  scopes      String[]
  tokenHash   String    @unique
  /// the first characters, so the owner can tell two tokens apart
  prefix      String
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// The registry of creatives (spec 7.3). Phase 1 keeps only what ties a CR##### to the studio script it came from;
/// the intake (T3.1) adds the rest of 7.3. Never deleted: an excluded creative stays as `excluded`.
model CreativeAsset {
  id          String   @id @default(cuid())
  crCode      String   @unique
  productCode String?
  /// studio · drive · clipper · customer · manual
  source      String
  /// the studio script id (VP-TRF01-0012-v2, a hook version ends in -h2)
  sourceRef   String?  @unique
  driveFileId String?
  status      String   @default("ready")
  notes       String?
  // ── Phase 3 (spec 7.3), additive: the permanent registry of every video ──
  fileName     String?
  md5          String?  @unique
  durationS    Decimal? @db.Decimal(8, 2)
  aspect       String? // 9:16 · 4:5 · 1:1
  resolution   String? // 1080x1920
  dateIn       DateTime @default(now())
  conceptId    String?
  hookType     String?
  style        String?
  angle        String?
  awareness    String?
  dialect      String?
  /// green · yellow · red · pending
  policyFlag   String   @default("pending")
  policyNote   String?
  /// md5 duplicate of this CR code (the file went to `excluded`, never deleted)
  dupOf        String?
  metaVideoId  String?
  thumbnailHash String?
  probe        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  thumbnails  ThumbnailCandidate[]
  policyChecks PolicyCheck[]
}

/// The CR##### counter: one row, incremented atomically; a number is never given twice, even if a row is removed.
model CreativeCounter {
  id   Int @id @default(1)
  last Int @default(0)
}

/// Every file the intake has seen in a Drive inbox, so a file is processed once (Drive id is the key).
model DriveFile {
  id           String   @id @default(cuid())
  driveId      String   @unique
  productCode  String?
  originalName String
  newName      String?
  folder       String // inbox · ready · excluded
  status       String // seen · processed · excluded · failed
  crCode       String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PolicyCheck {
  id          String        @id @default(cuid())
  assetId     String
  asset       CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  adText      String?
  transcript  String?
  ocrText     String?
  lpText      String?
  /// the dictionary hits: [{text, rule, level, alternative}]
  codeHits    Json
  agentVerdict String?
  /// green · yellow · red
  flag        String
  approvedBy  String?
  createdAt   DateTime      @default(now())
}

model ThumbnailCandidate {
  id         String        @id @default(cuid())
  assetId    String
  asset      CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  frameIndex Int
  atSeconds  Decimal       @db.Decimal(6, 2)
  path       String
  chosen     Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

// ───────────────────────────── Phase 2: the guard (spec 10) ─────────────────────────────

/// One change to Meta in its eight stages (spec 10.2).
model ChangeSet {
  id              String       @id @default(cuid())
  state           String // draft · simulated · pending_approval · approved · executing · executed · failed · rolled_back · rejected
  source          String // rule · agent · user · kill_switch · telegram
  sourceRef       String? // rule key, agent code or user id
  reasonCode      String
  sentence        String
  accountMetaId   String?
  /// the action kind of src/core/autonomy.ts
  kind            String
  spendDeltaDaily Decimal      @default(0) @db.Decimal(12, 2)
  simulation      Json?
  /// dry_run or live — how it was (or will be) executed
  writeMode       String       @default("dry_run")
  approvedBy      String?
  approvedAt      DateTime?
  executedAt      DateTime?
  verifiedAt      DateTime?
  followUp24      Json?
  followUp72      Json?
  rolledBackAt    DateTime?
  rolledBackBy    String?
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           ChangeItem[]

  @@index([state, createdAt])
}

model ChangeItem {
  id             String    @id @default(cuid())
  changeSetId    String
  changeSet      ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  op             String // pause · resume · set_budget
  objectType     String // campaign · adset · ad
  objectId       String // Meta id
  before         Json
  after          Json
  idempotencyKey String    @unique
  apiResponse    Json?
  verifyResult   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([objectId, createdAt])
}

/// Every evaluation that decided something (fired or alert-only), for the «القرارات» screen and the cooldowns.
model RuleRun {
  id          String   @id @default(cuid())
  rule        String
  level       String
  targetId    String
  action      String
  alertOnly   Boolean
  sentence    String
  changeSetId String?
  createdAt   DateTime @default(now())

  @@index([rule, targetId, createdAt])
}

/// A freeze on scaling or creating, for an object or a whole account, until it is lifted or expires.
model Freeze {
  id        String    @id @default(cuid())
  scope     String // account · product · adset · ad
  targetId  String
  kind      String // scale · create · all
  reason    String
  until     DateTime?
  liftedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([targetId, kind])
}

model KillSwitchEvent {
  id          String   @id @default(cuid())
  scope       String // all · act_…
  byUser      String
  changeSetId String?
  objects     Int
  createdAt   DateTime @default(now())
}
