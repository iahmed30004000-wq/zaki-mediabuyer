// Zaki Media Buyer — Phase 1 data model (spec 13.5). Additive only: later phases add tables, never reshape these.
// Every table: id · createdAt · updatedAt. Money is Decimal. No customer name / phone / address field anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── people, audit, settings ─────────────────────────────

enum Role {
  OWNER
  ADS_MANAGER
  ANALYST
  VIEWER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(VIEWER)
  /// bumped to sign every session of this person out
  sessionVer      Int       @default(1)
  active          Boolean   @default(true)
  lastLoginAt     DateTime?
  /// a member the owner invited: the sha256 of the one-time code (shown to the owner once), until it is used
  inviteHash      String?
  inviteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Who did what to what: a person, a rule or an agent. Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // user | rule | agent | system
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// A setting with its history: every change is a new version, and any version can be restored.
model Setting {
  key       String           @id
  value     Json
  version   Int              @default(1)
  updatedBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  versions  SettingVersion[]
}

model SettingVersion {
  id        String   @id @default(cuid())
  key       String
  version   Int
  value     Json
  changedBy String?
  createdAt DateTime @default(now())
  setting   Setting  @relation(fields: [key], references: [key], onDelete: Cascade)

  @@unique([key, version])
}

// ───────────────────────────── Meta: connection and assets ─────────────────────────────

model MetaConnection {
  id        String    @id @default(cuid())
  userId    String?
  kind      String // system_user | login
  scopes    String[]
  tokenEnc  String
  expiresAt DateTime?
  status    String    @default("active") // active | expired | revoked
  checkedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AdAccount {
  id            String     @id @default(cuid())
  metaId        String     @unique // act_…
  name          String
  currency      String
  timezone      String
  status        String
  market        String? // SY · JO · …
  autonomyLevel Int        @default(1)
  dailyCap      Decimal?   @db.Decimal(12, 2)
  monthlyCap    Decimal?   @db.Decimal(12, 2)
  spendCapMeta  Decimal?   @db.Decimal(12, 2)
  paymentStatus String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  campaigns     Campaign[]
}

model Page {
  id        String   @id @default(cuid())
  metaId    String   @unique
  name      String
  code      String? // SP · VP · AJ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dataset {
  id        String   @id @default(cuid())
  metaId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The rate-limit headers of every Meta call (business use case usage), for the dashboard counter.
model ApiUsage {
  id        String   @id @default(cuid())
  scope     String
  callCount Int
  cpuTime   Int
  totalTime Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────────── structure ─────────────────────────────

model Campaign {
  id              String    @id @default(cuid())
  metaId          String    @unique
  accountId       String
  account         AdAccount @relation(fields: [accountId], references: [id])
  name            String
  status          String
  objective       String?
  parsedMarket    String?
  productCode     String?
  parsedObjective String?
  stage           String?
  namingOk        Boolean   @default(false)
  /// how the product was found: name | alias | none
  productVia      String?
  budgetType      String? // CBO | ABO
  dailyBudget     Decimal?  @db.Decimal(12, 2)
  bidStrategy     String?
  spendCap        Decimal?  @db.Decimal(12, 2)
  /// when it started delivering (Meta start_time) — «days running»
  startTime       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  adsets          AdSet[]
}

model AdSet {
  id                    String    @id @default(cuid())
  metaId                String    @unique
  campaignId            String
  campaign              Campaign  @relation(fields: [campaignId], references: [id])
  name                  String
  status                String
  audienceCode          String?
  pageCode              String?
  conceptId             String?
  optimizationGoal      String?
  dailyBudget           Decimal?  @db.Decimal(12, 2)
  learningStage         String?
  lastSignificantEditAt DateTime?
  startTime             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  ads                   Ad[]
}

model Ad {
  id           String    @id @default(cuid())
  metaId       String    @unique
  adSetId      String
  adSet        AdSet     @relation(fields: [adSetId], references: [id])
  name         String
  status       String
  creativeCode String?
  hookCode     String?
  angleCode    String?
  lpCode       String?
  reviewStatus String?
  startTime    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ProductAlias {
  id          String   @id @default(cuid())
  productCode String
  alias       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productCode, alias])
}

// ───────────────────────────── numbers and truth ─────────────────────────────

/// One row per object per day, archived forever (Meta deletes old detail). Re-pulling a day overwrites it.
model InsightDaily {
  id                 String   @id @default(cuid())
  level              String // account | campaign | adset | ad
  objectId           String // Meta id
  date               DateTime @db.Date
  spend              Decimal  @db.Decimal(12, 2)
  impressions        Int
  reach              Int
  frequency          Decimal  @db.Decimal(8, 4)
  linkClicks         Int
  outboundClicks     Int
  lpv                Int
  purchases          Int
  conversations      Int
  video3s            Int
  thruplays          Int
  p25                Int
  p50                Int
  p75                Int
  p95                Int
  p100               Int
  qualityRanking     String?
  engagementRanking  String?
  conversionRanking  String?
  /// the attribution window this row was pulled with — always explicit (spec 4)
  attributionSetting String
  source             String   @default("api") // api | import
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([level, objectId, date])
  @@index([date])
}

/// An OMS order and the ad it came from. No customer data: capiRef is an encrypted reference only CAPI code opens.
model AttributedOrder {
  id           String    @id @default(cuid())
  omsOrderId   String    @unique
  productCode  String
  market       String
  channel      String // website | whatsapp | messenger
  adId         String?
  adSetId      String?
  campaignId   String?
  adName       String?
  lpUrl        String?
  /// ad_id | naming | allocation | none
  method       String
  status       String
  createdAtOms DateTime
  confirmedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  returnedAt   DateTime?
  canceledAt   DateTime?
  orderValue   Decimal   @db.Decimal(12, 2)
  collected    Decimal?  @db.Decimal(12, 2)
  currency     String
  isFake       Boolean   @default(false)
  capiRef      String?
  matureAt     DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([adId])
  @@index([productCode, createdAtOms])
}

/// The computed truth (spec 6.2 / 6.3) per level per day — what the screens and the report read.
model TruthDaily {
  id                 String   @id @default(cuid())
  level              String // product | campaign | adset | ad
  objectId           String
  date               DateTime @db.Date
  spendWithFee       Decimal  @db.Decimal(12, 2)
  orders             Int
  matureOrders       Int
  confirmed          Int
  shipments          Int
  delivered          Int
  returned           Int
  costPerConfirmed   Decimal? @db.Decimal(12, 4)
  confirmRate        Decimal? @db.Decimal(8, 6)
  deliveryRate       Decimal? @db.Decimal(8, 6)
  returnRate         Decimal? @db.Decimal(8, 6)
  netCollected       Decimal  @db.Decimal(12, 2)
  lossLimit          Decimal? @db.Decimal(12, 4)
  scalingCeiling     Decimal? @db.Decimal(12, 4)
  profitAfterCosts   Decimal  @db.Decimal(12, 2)
  profitPerDelivered Decimal? @db.Decimal(12, 4)
  trueRoas           Decimal? @db.Decimal(10, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([level, objectId, date])
}

model UnattributedPool {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  campaignMetaId String
  spend          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([campaignMetaId, date])
}

/// The numbers of a product for the calculator (spec 6.3). source: estimate until 50 shipments, then actual.
model ProductEconomics {
  id          String   @id @default(cuid())
  productCode String   @unique
  name        String
  market      String
  price       Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @db.Decimal(12, 2)
  deliveryFee Decimal  @db.Decimal(12, 2)
  returnFee   Decimal  @db.Decimal(12, 2)
  codFeePct   Decimal  @db.Decimal(6, 4)
  confirmCost Decimal  @db.Decimal(12, 2)
  stockDays   Int?
  source      String   @default("estimate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────── jobs, alerts, reports, agents ─────────────────────────────

/// A scheduled job run. The unique (job, slot) row is the lock: a job never runs twice for the same slot.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  slot       String
  status     String // running | ok | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  stats      Json?

  @@unique([job, slot])
  @@index([job, startedAt])
}

model Alert {
  id        String    @id @default(cuid())
  kind      String
  tone      String // danger | warn | info
  text      String
  href      String?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Report {
  id        String    @id @default(cuid())
  kind      String // morning | weekly | monthly
  forDate   DateTime  @db.Date
  text      String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([kind, forDate])
}

/// Every model call: which agent, which provider, cost, and whether the privacy filter blocked it.
model AgentRun {
  id        String   @id @default(cuid())
  agent     String
  provider  String
  model     String
  ok        Boolean
  blocked   String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costUsd   Decimal  @default(0) @db.Decimal(10, 4)
  ms        Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  @@index([agent, createdAt])
}

// ───────────────────────────── the content studio (docs/STUDIO_DATA_CONTRACT_AR.md) ─────────────────────────────

/// A token another system (the content studio) calls this one with. Only the sha256 is kept; the token is shown once.
model ApiToken {
  id          String    @id @default(cuid())
  name        String
  /// vp:read · vp:launch — never a scope that approves spend
  scopes      String[]
  tokenHash   String    @unique
  /// the first characters, so the owner can tell two tokens apart
  prefix      String
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// The registry of creatives (spec 7.3). Phase 1 keeps only what ties a CR##### to the studio script it came from;
/// the intake (T3.1) adds the rest of 7.3. Never deleted: an excluded creative stays as `excluded`.
model CreativeAsset {
  id            String               @id @default(cuid())
  crCode        String               @unique
  productCode   String?
  /// studio · drive · clipper · customer · manual
  source        String
  /// the studio script id (VP-TRF01-0012-v2, a hook version ends in -h2)
  sourceRef     String?              @unique
  driveFileId   String?
  status        String               @default("ready")
  notes         String?
  // ── Phase 3 (spec 7.3), additive: the permanent registry of every video ──
  fileName      String?
  md5           String?              @unique
  durationS     Decimal?             @db.Decimal(8, 2)
  aspect        String? // 9:16 · 4:5 · 1:1
  resolution    String? // 1080x1920
  dateIn        DateTime             @default(now())
  conceptId     String?
  hookType      String?
  style         String?
  angle         String?
  awareness     String?
  dialect       String?
  /// green · yellow · red · pending
  policyFlag    String               @default("pending")
  policyNote    String?
  /// md5 duplicate of this CR code (the file went to `excluded`, never deleted)
  dupOf         String?
  metaVideoId   String?
  thumbnailHash String?
  probe         Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  thumbnails    ThumbnailCandidate[]
  policyChecks  PolicyCheck[]
}

/// The CR##### counter: one row, incremented atomically; a number is never given twice, even if a row is removed.
model CreativeCounter {
  id   Int @id @default(1)
  last Int @default(0)
}

/// Every file the intake has seen in a Drive inbox, so a file is processed once (Drive id is the key).
model DriveFile {
  id           String   @id @default(cuid())
  driveId      String   @unique
  productCode  String?
  originalName String
  newName      String?
  folder       String // inbox · ready · excluded
  status       String // seen · processed · excluded · failed
  crCode       String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PolicyCheck {
  id           String        @id @default(cuid())
  assetId      String
  asset        CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  adText       String?
  transcript   String?
  ocrText      String?
  lpText       String?
  /// the dictionary hits: [{text, rule, level, alternative}]
  codeHits     Json
  agentVerdict String?
  /// green · yellow · red
  flag         String
  approvedBy   String?
  createdAt    DateTime      @default(now())
}

model ThumbnailCandidate {
  id         String        @id @default(cuid())
  assetId    String
  asset      CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  frameIndex Int
  atSeconds  Decimal       @db.Decimal(6, 2)
  path       String
  chosen     Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

// ───────────────────────────── Phase 2: the guard (spec 10) ─────────────────────────────

/// One change to Meta in its eight stages (spec 10.2).
model ChangeSet {
  id              String       @id @default(cuid())
  state           String // draft · simulated · pending_approval · approved · executing · executed · failed · rolled_back · rejected
  source          String // rule · agent · user · kill_switch · telegram
  sourceRef       String? // rule key, agent code or user id
  reasonCode      String
  sentence        String
  accountMetaId   String?
  /// the action kind of src/core/autonomy.ts
  kind            String
  spendDeltaDaily Decimal      @default(0) @db.Decimal(12, 2)
  simulation      Json?
  /// dry_run or live — how it was (or will be) executed
  writeMode       String       @default("dry_run")
  approvedBy      String?
  approvedAt      DateTime?
  executedAt      DateTime?
  verifiedAt      DateTime?
  followUp24      Json?
  followUp72      Json?
  rolledBackAt    DateTime?
  rolledBackBy    String?
  error           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           ChangeItem[]

  @@index([state, createdAt])
}

model ChangeItem {
  id             String    @id @default(cuid())
  changeSetId    String
  changeSet      ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  op             String // pause · resume · set_budget
  objectType     String // campaign · adset · ad
  objectId       String // Meta id
  before         Json
  after          Json
  idempotencyKey String    @unique
  /// the order inside the change (a launch creates the campaign before its ad sets, and switches on last)
  seq            Int       @default(0)
  apiResponse    Json?
  verifyResult   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([objectId, createdAt])
}

/// Every evaluation that decided something (fired or alert-only), for the «القرارات» screen and the cooldowns.
model RuleRun {
  id          String   @id @default(cuid())
  rule        String
  level       String
  targetId    String
  action      String
  alertOnly   Boolean
  sentence    String
  changeSetId String?
  createdAt   DateTime @default(now())

  @@index([rule, targetId, createdAt])
}

/// A freeze on scaling or creating, for an object or a whole account, until it is lifted or expires.
model Freeze {
  id        String    @id @default(cuid())
  scope     String // account · product · adset · ad
  targetId  String
  kind      String // scale · create · all
  reason    String
  until     DateTime?
  liftedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([targetId, kind])
}

model KillSwitchEvent {
  id          String   @id @default(cuid())
  scope       String // all · act_…
  byUser      String
  changeSetId String?
  objects     Int
  createdAt   DateTime @default(now())
}

// ───────────────────────────── phase 4: tests · conversions · account safety ─────────────────────────────

/// A test (spec 5.3 / T4.2): what we believe, how it is set up, when it stops, what came out.
model Experiment {
  id             String    @id @default(cuid())
  /// product · creative · fair_creative · landing
  kind           String
  productCode    String
  market         String
  hypothesis     String
  /// template, budget, days, the creatives / landing pages being compared
  setup          Json
  /// the stop rules in force (spend without orders, max days, min sample)
  stopRules      Json
  /// planned · running · done · stopped
  status         String    @default("planned")
  changeSetId    String?
  campaignMetaId String?
  startedAt      DateTime?
  endsAt         DateTime?
  /// winner, per-arm numbers from the truth, the sentence the owner reads
  result         Json?
  verdict        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

/// One conversion event for Meta (spec 9.1): one per order and status, never twice. No customer identifier is kept
/// here — they are fetched from the OMS at send time, hashed in memory and dropped.
model CapiEvent {
  id         String    @id @default(cuid())
  /// oms-<order>-<status> — the dedupe key Meta uses too
  eventId    String    @unique
  omsOrderId String
  eventName  String
  channel    String // website · whatsapp · messenger
  eventTime  DateTime
  datasetId  String?
  value      Decimal?  @db.Decimal(12, 2)
  currency   String?
  /// pending · sent · rejected · expired · skipped
  state      String    @default("pending")
  attempts   Int       @default(0)
  error      String?
  response   Json?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([state, eventTime])
  @@index([omsOrderId])
}

/// A read of one ad account's health (spec S11): status, why it is disabled, payment, rejected ads.
model AccountHealth {
  id            String   @id @default(cuid())
  accountMetaId String
  status        String
  disableReason String?
  paymentOk     Boolean  @default(true)
  rejectedAds   Int      @default(0)
  /// ok · watch · restricted
  verdict       String
  notes         Json?
  createdAt     DateTime @default(now())

  @@index([accountMetaId, createdAt])
}

/// A rejected ad and its appeal draft (written by the system, sent only by a person).
model ReviewIssue {
  id            String   @id @default(cuid())
  adMetaId      String
  adName        String
  accountMetaId String?
  /// Meta's review feedback, as given
  feedback      Json
  policyKey     String?
  appealDraft   String?
  /// open · appealed · fixed · dropped
  status        String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([adMetaId])
}

/// A lesson the weekly review found (spec T5.3 «سجل الدروس»): one key per dimension and week, with its evidence.
model Lesson {
  id        String   @id @default(cuid())
  /// concept:CPT0012 · angle:HER · hook:H07 · page:SP · lp:LP1
  key       String
  week      DateTime @db.Date
  text      String
  evidence  String
  source    String   @default("code")
  createdAt DateTime @default(now())

  @@unique([key, week])
  @@index([week])
}

/// A request to the content studio (docs/STUDIO_DATA_CONTRACT_AR.md §4.2 #6–7): the studio's machine pulls the queue
/// when it is on, claims one, and hands back a result — never the other way round.
model CreativeRequest {
  id          String    @id @default(cuid())
  /// new_hooks (new hooks on the same body — the usual case, 7.6) · new_script
  kind        String
  productCode String
  /// the studio script of the tired winner (CreativeAsset.sourceRef), when it came from the studio
  vpId        String?
  crCode      String?
  count       Int       @default(4)
  /// why, the winning tags, notes for the first frame, the forbidden words
  brief       Json
  /// pending · claimed · done · cancelled
  status      String    @default("pending")
  claimedAt   DateTime?
  leaseUntil  DateTime?
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([crCode])
}

/// One imported file (spec S13): its fingerprint, so the same file imported twice is said and changes nothing.
model ImportBatch {
  id         String   @id @default(cuid())
  /// meta_insights
  kind       String
  sha256     String
  fileName   String
  rows       Int
  unknownAds Int      @default(0)
  byUser     String?
  createdAt  DateTime @default(now())

  @@unique([kind, sha256])
}

/// The two-readings rule of the instant alerts (spec 12.3): how many readings in a row saw a condition, and when it
/// was raised. A condition that disappears is removed, so it can be raised again when it returns.
model AlertState {
  key        String    @id
  count      Int
  lastSeenAt DateTime
  raisedAt   DateTime?
  updatedAt  DateTime  @updatedAt
}

/// A launch request from the content studio (contract §4.2 #2–4). It feeds the normal intake; the owner launches
/// from the wizard. Its status is derived from the creative and the launch change set it is linked to.
model LaunchRequest {
  id           String   @id @default(cuid())
  vpId         String
  /// active · test
  mode         String
  checksum     String
  /// the stored upload, until the intake took it
  filePath     String?
  crCode       String?
  changeSetId  String?
  /// set when the intake ended badly (broken file) or the request was cancelled
  closedStatus String?
  reason       String?
  errorCode    String?
  /// the meta part as received, minus the thumbnail (no customer data exists in it)
  meta         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vpId, mode])
  @@index([crCode])
}

// ───────────────────────────── v3 / v4: the cockpit — Claude's pushes, approvals, workflows, tasks ─────────────────────────────
// Additive only. Nothing in here holds a customer name, phone or address.

/// Stock per product, as pushed: the newest row of a product is what the screens show, the rest is its history.
model StockSnapshot {
  id          String   @id @default(cuid())
  productCode String
  units       Int?
  daysCover   Decimal  @db.Decimal(8, 1)
  /// mcp · manual · oms
  source      String   @default("mcp")
  at          DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([productCode, at])
}

/// The video bank as pushed: the owner's own numbering (JOB, V name) beside the Drive and Meta ids. Never deleted.
model VideoBankItem {
  id             String   @id @default(cuid())
  job            String
  vName          String
  productCode    String
  driveFileId    String?
  /// the Drive file of its scenario (03_السيناريوهات) — the card links to it and every request to Hermes carries it
  scenarioFileId String?
  metaVideoId    String?
  /// bank · requested · ready · uploaded · testing · winner · fatigued · dropped
  status         String   @default("bank")
  notes          String?
  source         String   @default("mcp")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([job, vName])
  @@index([productCode, status])
}

/// A workflow as the owner sees it on الورك فلو: nodes and edges, a schedule, who runs it, how risky it is.
model Workflow {
  id          String            @id @default(cuid())
  /// the id Claude's log_run uses (daily-check, night-round …)
  key         String            @unique
  name        String
  description String?
  /// a 5-field cron in Asia/Amman, or null (manual / by event)
  schedule    String?
  /// claude_mcp · claude_task · claude_desktop · claude_api · hermes · muse · n8n · telegram · http · person · system
  executor    String            @default("claude_mcp")
  /// where its numbers come from: api · mcp · manual — the canvas looks the same for all three
  dataSource  String            @default("mcp")
  /// green · yellow · red · black
  permission  String            @default("green")
  enabled     Boolean           @default(true)
  graph       Json
  version     Int               @default(1)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  runs        WorkflowRun[]
  versions    WorkflowVersion[]
}

/// Every saved version of a workflow's drawing (v3 · F): the graph as it was, who saved it, and what changed in a line.
/// Never deleted: going back loads an old one as a NEW version.
model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])
  version    Int
  graph      Json
  /// the owner's words, or what changed («+2 خطوة · 1 تعديل»)
  note       String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([workflowId, version])
}

model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id])
  /// the caller's own id of this run, so the same log_run twice is one run
  ref        String
  /// running · ok · failed · waiting · skipped
  status     String
  /// schedule · manual · event
  trigger    String    @default("schedule")
  /// mcp · worker · ui · n8n
  source     String    @default("mcp")
  startedAt  DateTime
  finishedAt DateTime?
  summary    String?
  metrics    Json?
  artifacts  Json?
  /// the live state of each node: { nodeId: { status, at, note } }
  nodeStates Json      @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([workflowId, ref])
  @@index([startedAt])
  @@index([status])
}

/// A request for the owner's decision (title, why, numbers, amount, options) — it rings the phone when it is urgent.
model Approval {
  id             String    @id @default(cuid())
  /// the caller's own id, so a retried request_approval is one approval
  ref            String?   @unique
  title          String
  why            String
  /// { decision, analysis, ifYes, ifNo, recommendation } — the «ليش؟» page
  analysis       Json?
  /// [{ label, value }]
  numbers        Json?
  /// [{ key, label }] — approve / reject by default
  options        Json?
  amount         Decimal?  @db.Decimal(12, 2)
  /// red rings · orange: a notification with a sound · yellow: silent, shown in اليوم
  urgency        String    @default("orange")
  /// pending · approved · rejected · postponed · cancelled · expired
  status         String    @default("pending")
  /// mcp · workflow · user
  source         String    @default("mcp")
  workflowKey    String?
  /// what kind of decision it is (cap_raise · manufacturing · …) — the owner marks kinds «يصحّيني»
  kind           String?
  expiresAt      DateTime?
  postponedUntil DateTime?
  chosenOption   String?
  decisionNote   String?
  decidedBy      String?
  decidedAt      DateTime?
  /// the owner marked this kind «يصحّيني»: it may ring while he sleeps
  wakeOwner      Boolean   @default(false)
  /// when it last rang or was pushed to the phone
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

/// A non-blocking alert (🔴 · 🟠 · 🟡) for the owner or a person; it shows in اليوم and goes out on Telegram / the phone.
model Notification {
  id        String    @id @default(cuid())
  /// red · orange · yellow
  urgency   String
  /// owner, or a person's key (abdullah · mohammad …)
  audience  String    @default("owner")
  title     String
  body      String?
  href      String?
  /// mcp · workflow · rule
  source    String    @default("mcp")
  /// the same alert twice is one: stock:TIN01:red:2026-11-14
  key       String?
  readAt    DateTime?
  /// when it left (Telegram / the phone), if it did
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([audience, key])
  @@index([audience, createdAt])
}

/// A task of the team or of an agent — one place for «what waits for whom». Archived, never deleted.
model Task {
  id         String    @id @default(cuid())
  title      String
  note       String?
  /// new · doing · waiting_approval · stalled · done
  status     String    @default("new")
  /// a person or an agent (abdullah · hassan · laith · mohammad · hermes · muse · claude)
  assignee   String?
  /// claude · hermes · muse · n8n · person · system
  executor   String?
  dueAt      DateTime?
  /// low · normal · high · urgent
  priority   String    @default("normal")
  /// what it is about: workflow · approval · video · campaign · product
  linkType   String?
  linkId     String?
  /// main · confirmation · leak · basha · stock …
  board      String    @default("main")
  /// ui · mcp · workflow · assistant
  source     String    @default("ui")
  archivedAt DateTime?
  /// Zaki Workspace (the one-way door, v3 · W): this task's id there once it was sent, when it was last asked about, the last refusal
  wsId       String?   @unique
  wsSyncedAt DateTime?
  wsError    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, board])
  @@index([assignee])
}

/// «وضع التعديل» (v3 · K): what was typed into a field the owner added to a card (a task, a video). The fields themselves are
/// config (the setting `ui.config`); this is only the values, kept by the card's id, so hiding, merging or archiving a field
/// never touches them.
model CustomValue {
  /// task · video
  entity    String
  entityId  String
  /// the field's id in `ui.config` (f-xxxxxx)
  fieldId   String
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@id([entity, entityId, fieldId])
  @@index([entity, fieldId])
}

/// A phone or a browser that may be pushed to (an FCM token or a Web Push subscription). The token is a secret: never shown, never logged.
model PushDevice {
  id         String    @id @default(cuid())
  userId     String?
  /// fcm · webpush
  kind       String
  token      String    @unique
  /// Web Push keys (p256dh, auth); null for FCM
  keys       Json?
  label      String?
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Everything about one product on one business day (Asia/Amman) — v4.1 «الأرقام». Raw counts and amounts only, pushed by
/// Claude on a «product» row (any field may be empty: a later push fills it, never wipes it). Every ratio on screen —
/// rates, costs per order, the expected revenue — is computed from these by src/core/numbers.ts, never stored.
model ProductDay {
  id              String   @id @default(cuid())
  productCode     String
  date            DateTime @db.Date
  // ads (Meta), when pushed per product
  spend           Decimal? @db.Decimal(12, 2)
  impressions     Int?
  linkClicks      Int?
  pixelPurchases  Int?
  // orders that came in (OMS)
  ordersIn        Int?
  uniqueCustomers Int?
  // the confirmation
  confirmed       Int?
  rejected        Int?
  cancelled       Int?
  /// still waiting for confirmation when it was read (a state, not a flow)
  waiting         Int?
  /// [{ reason, count }]
  rejectReasons   Json?
  // the offers: [{ offer, orders, pieces?, revenue? }]
  offerBreakdown  Json?
  aov             Decimal? @db.Decimal(12, 2)
  // the shipping
  shippedOrders   Int?
  shippedPieces   Int?
  /// states when it was read
  outForDelivery  Int?
  stuck           Int?
  delivered       Int?
  returned        Int?
  // the money
  revenueShipped  Decimal? @db.Decimal(12, 2)
  expectedRevenue Decimal? @db.Decimal(12, 2)
  /// units left
  stockUnits      Int?
  source          String   @default("mcp")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productCode, date])
  @@index([date])
}

/// A step that Claude (or a person) has to finish by hand (v3 · F «طابور التسليم»): a run the owner started with «شغّل هلق»,
/// or a step that failed, timed out or waits on a connection that is not there yet. It carries what is needed to do the
/// step (the prompt, the inputs, the last error — never customer data); completing it moves the workflow's run on.
/// Claude reads it with get_handoffs / GET /api/v1/handoffs and answers with complete_handoff / POST …/complete.
model Handoff {
  id          String    @id @default(cuid())
  workflowKey String
  /// the run it holds up: whoever does it passes this ref to log_run
  runRef      String?
  nodeId      String?
  /// manual_run · node_failed · missing_connection · timeout · needs_input
  kind        String
  title       String
  /// { need, lastError, prompt, inputs, steps } — filtered for customer data when written
  context     Json      @default("{}")
  /// who should do it: claude · claude_desktop · hermes · muse · a person's key
  assignee    String    @default("claude")
  /// open · claimed · done · cancelled
  status      String    @default("open")
  claimedBy   String?
  claimedAt   DateTime?
  result      Json?
  resultNote  String?
  doneBy      String?
  doneAt      DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, assignee])
  @@index([workflowKey, status])
}

/// A request about one video of the board (v3 · D): «بدو هوكات جديدة» · «بدو سيناريو جديد» · «ارفعه للتيست» · «تعب».
/// It goes to Hermes (the API, or a chat), shows as a card on المهام, and moves طلب ← عند هيرمز ← جاهز ← مرفوع.
/// It carries the video's JOB, its scenario file and the numbers the code computed — never a customer's detail.
/// Never deleted: a cancelled request stays, as cancelled.
model VideoRequest {
  id             String    @id @default(cuid())
  /// the video: «JOB|V» (the owner's bank) or its CR code (the registry)
  videoKey       String
  /// new_hooks · new_script · to_test · tired
  kind           String
  productCode    String
  job            String?
  vName          String?
  crCode         String?
  driveFileId    String?
  scenarioFileId String?
  /// asked · with_hermes · ready · uploaded · cancelled
  status         String    @default("asked")
  /// what the video had done when it was asked (code-made): spend, orders, cost per order, hook, hold, ctr, days, tired signal
  numbers        Json      @default("{}")
  note           String?
  /// the card on المهام that mirrors it
  taskId         String?
  /// how it reached Hermes: api · telegram · none
  via            String    @default("none")
  deliveredAt    DateTime?
  deliveryError  String?
  claimedBy      String?
  claimedAt      DateTime?
  /// what Hermes answered (a note and a few names) and the videos it made
  result         Json?
  resultNote     String?
  readyAt        DateTime?
  uploadedAt     DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([videoKey, status])
}

/// «محادثة المساعد» (v3 · H): one rolling conversation per signed-in person, so closing the panel, a refresh or another device does not lose it.
/// What is kept is what the panel showed (the person's questions and the answers, with their sources and drafts); it passed the privacy check on the way in.
model AssistantChat {
  userId    String   @id
  messages  Json
  updatedAt DateTime @updatedAt
}
