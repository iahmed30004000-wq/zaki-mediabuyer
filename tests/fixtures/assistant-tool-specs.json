        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "مثلاً: (4.15 - 3.8) / 3.8 * 100"
        }
      },
      "required": [
        "expression"
      ],
      "additionalProperties": false
    }
  },
