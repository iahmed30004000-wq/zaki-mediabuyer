          "minimum": 1,
          "maximum": 15
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_videos",
    "description": "لوحة الفيديوهات لكل منتج: كم فيديو بالبنك من 50، الرابحين (الأرخص طلب حقيقي فوق حد الصرف الأدنى)، كم تعبان، وكم طلب مفتوح عند هيرمز.",
    "input_schema": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string",
          "maxLength": 60,
          "description": "كود المنتج أو اسمه (فاضي = كل المنتجات)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_tasks",
    "description": "مهام الفريق (آخر 14 يوم للمنتهية): العنوان والحالة والمسؤول والموعد والأولوية — ورقم كل مهمة (id) لتعدّلها بـ update_task. الافتراضي: كل المفتوحة.",
    "input_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "new",
              "doing",
              "waiting_approval",
              "stalled",
              "done"
            ]
          },
          "maxItems": 5,
          "description": "new · doing · waiting_approval · stalled · done"
        },
        "assignee": {
          "type": "string",
          "maxLength": 40,
          "description": "abdullah · hassan · laith · mohammad · hermes · muse · claude"
        },
        "board": {
          "type": "string",
          "maxLength": 40,
          "description": "مفتاح اللوحة (main · confirmation · leak · basha · stock، أو لوحة المالك — المفاتيح بنتيجة هالأداة)"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_day",
    "description": "إنجاز يوم واحد (توقيت عمّان): شو انعمل (تشغيلات، قرارات، مهام خلصت، فيديوهات تحرّكت) وشو مخطّط — مكتوب أسطر من الكود. استعملها لـ «لخّصلي يوم كذا» و«شو خلّصنا».",
    "input_schema": {
      "type": "object",
      "properties": {
        "day": {
          "type": "string",
          "maxLength": 10,
          "description": "today (الافتراضي) · yesterday · أو YYYY-MM-DD"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_changes",
    "description": "تغييرات الحملات: «pending» = اللي بانتظار موافقة المالك أو اقتراح مسجّل · «recent» = اللي صار آخر 3 أيام (تنفّذ/انرجع/انرفض/فشل) مع سبب كل واحد. استعملها لـ «ليش وقف…» و«شو بانتظاري».",
    "input_schema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "recent"
          ],
          "description": "الافتراضي pending"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_workflows",
    "description": "الورك فلو: بدون key = القائمة (المفتاح، شغّال؟، جدولته، آخر حالة). مع key = رسم واحد: خطواته (id · type · label · executor) ووصلاته — اللي بتحتاجه لتقترح خطوة بـ draft_node.",
    "input_schema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 60
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_overview",
    "description": "صورة عامة من الكود: مستوى كل حساب وسقفه، آخر 7 أيام لكل منتج (صرف، مؤكد، تكلفة المؤكد، سقف التكبير، ربح)، التغييرات بانتظار المالك، قرارات الأمان آخر 24 ساعة، التنبيهات، وخطة الأسبوع. للأسئلة العامة («كيف الوضع؟»).",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "explain",
    "description": "شرح شاشة (شو هاي الصفحة، الخطوة الجاية، أجزاءها) و/أو معادلة رقم («قاعدة الاحتساب»: معادلته ومصدره ومعناه). بدون أي وسيط: شرح الصفحة اللي المالك فيها هلأ.",
    "input_schema": {
      "type": "object",
      "properties": {
        "place": {
          "type": "string",
          "enum": [
            "today",
            "ads",
            "videos",
            "tasks",
            "workflow",
            "done",
            "settings"
          ],
          "description": "مفتاح الصفحة"
        },
        "term": {
          "type": "string",
          "maxLength": 60,
          "description": "اسم الرقم أو مفتاحه، مثلاً «تكلفة الطلب الحقيقي» أو costPerOrder"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "calculate",
