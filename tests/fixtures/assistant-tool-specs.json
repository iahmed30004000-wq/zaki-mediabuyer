  {
    "name": "draft_job",
    "description": "جهّز مسودة مهمة من جملة المالك (مثلاً «كل يوم الساعة 9:30 اقرا المخزون وبلّغني لو في شي ناقص»). ما بيتحفظ شي: بتظهر للمالك بطاقة «هيك فهمتها — صح؟» وهو بيعتمدها أو بيعدّلها. إذا ناقصك شي ما بتعرفه (مين بينفّذها، أو إيمتى) اسأله بدل ما تخمّن.\nالحقول: name اسم قصير · domain: ads (إعلانات) أو ops (فريق وتشغيل) · assigneeKey: مفتاح الوكيل أو الشخص من دليل الفريق، أو site إذا الموقع بينفّذها لحاله بوصفة.\nwhen: now (هلق) · once {date:YYYY-MM-DD,time:HH:MM} · daily {time} · hourly {from,to,everyHours:1|2|3|4|6} · weekly {days:[0..6] (0 الأحد),time} · window {everyHours,until:ISO}. الأوقات كلها بتوقيت عمّان بصيغة 24 ساعة. مرة وحدة بالماضي مرفوضة.\nsteps (للوكلاء والأشخاص): كل خطوة {verb,text}: verb واحد من read · compare · decide · do · wait_me · tell · ask (قراءة · مقارنة · قرّر (إذا) · نفّذ · استنى موافقة المالك · بلّغ · اطلب من حدا). decide ممكن معها elseGoto: رقم خطوة بعد اللي بعدها (من 0)، أو \"end\". لحد 20 خطوة، والنص لحد 100 حرف. ما تحط أرقام هواتف ولا إيميلات ولا مفاتيح.\nnotifyOn: done (لما تخلص) · stuck (لما توقف) · missed (لما تفوت) · failed (لما تفشل). الافتراضي المعتاد: stuck و missed و failed.\nالوصفات (لما الموقع هو المنفّذ، assigneeKey = \"site\" وsteps فاضية): recipe {name, params}: stock_alert = نبّهني لما منتج يقرب يخلص · daily_summary = ابعتلي ملخص اليوم · remind = ذكّر شخص · metric_watch = نبّهني لما رقم يعدّي حد. params: stock_alert {product: \"all\" أو كود المنتج} · daily_summary {period: today|yesterday} · remind {person: مفتاح شخص (مش وكيل), text: نص التذكير} · metric_watch {metric: realCost|orders|confirmRate|spend|costPerConfirmed|deliveredRate (deliveredRate بس مع كود منتج، مش مع \"all\"), product: \"all\" أو كود, op: above|below, limit: رقم, period: today|yesterday|7d}.\nمهمة متكررة لشخص ما بتنفع (الشخص ما بيسجّل تشغيل): مرة وحدة بس، أو اعطها لوكيل. أي تغيير على الإعلانات بيضل بموافقة المالك: المهمة مسودة وصف شغل بس.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 240
        },
        "domain": {
          "type": "string",
          "enum": [
            "ads",
            "ops"
          ]
        },
        "assigneeKey": {
          "type": "string",
          "maxLength": 40
        },
        "when": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "now"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "once"
                },
                "date": {
                  "type": "string",
                  "maxLength": 10
                },
                "time": {
                  "type": "string",
                  "maxLength": 5
                }
              },
              "required": [
                "kind",
                "date",
                "time"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "daily"
                },
                "time": {
                  "type": "string",
                  "maxLength": 5
                }
              },
              "required": [
                "kind",
                "time"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "hourly"
                },
                "from": {
                  "type": "string",
                  "maxLength": 5
                },
                "to": {
                  "type": "string",
                  "maxLength": 5
                },
                "everyHours": {
                  "anyOf": [
                    {
                      "const": 1
                    },
                    {
                      "const": 2
                    },
                    {
                      "const": 3
                    },
                    {
                      "const": 4
                    },
                    {
                      "const": 6
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "from",
                "to",
                "everyHours"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "weekly"
                },
                "days": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "maxItems": 14
                },
                "time": {
                  "type": "string",
                  "maxLength": 5
                }
              },
              "required": [
                "kind",
                "days",
                "time"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "window"
                },
                "everyHours": {
                  "anyOf": [
                    {
                      "const": 1
                    },
                    {
                      "const": 2
                    },
                    {
                      "const": 3
                    },
                    {
                      "const": 4
                    },
                    {
                      "const": 6
                    }
                  ]
                },
                "until": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "required": [
                "kind",
                "everyHours",
                "until"
              ],
              "additionalProperties": false
            }
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "verb": {
                "type": "string",
                "enum": [
                  "read",
                  "compare",
                  "decide",
                  "do",
                  "wait_me",
                  "tell",
                  "ask"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 300
              },
              "elseGoto": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "const": "end"
                  }
                ]
              }
            },
            "required": [
              "verb",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "notifyOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "done",
              "stuck",
              "missed",
              "failed"
            ]
          },
          "maxItems": 4
        },
        "recipe": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "stock_alert",
                "daily_summary",
                "remind",
                "metric_watch"
              ]
            },
            "params": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "required": [
            "name",
            "params"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "domain",
        "assigneeKey",
        "when",
        "steps",
        "notifyOn"
      ],
      "additionalProperties": false
    }
  }
