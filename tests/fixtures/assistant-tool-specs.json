  {
    "name": "propose_change",
    "description": "اقترح تغيير على حملة/مجموعة/إعلان: pause (إيقاف) · resume (تشغيل) · set_budget (ميزانية يومية جديدة، ±50% من الحالية كحد أقصى، للحملة أو المجموعة). الأرقام (object_id) من get_ads. هاد اقتراح بس: بيروح «المهام ← بانتظار موافقتك» وما بيتنفّذ إلا بموافقة المالك على الموقع — ما تقول «تم» أبداً. اشرح بالجملة (sentence) السبب بالأرقام.",
    "input_schema": {
      "type": "object",
      "properties": {
        "sentence": {
          "type": "string",
          "minLength": 5,
          "maxLength": 280,
          "description": "سطر واحد: شو بدك ولماذا (بالأرقام اللي رجعت من الأدوات)"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "pause",
                  "resume",
                  "set_budget"
                ]
              },
              "object_type": {
                "type": "string",
                "enum": [
                  "campaign",
                  "adset",
                  "ad"
                ]
              },
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "الرقم (id) من get_ads"
              },
              "daily_budget": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000,
                "description": "للـ set_budget بس: الميزانية اليومية الجديدة بالدولار"
              }
            },
            "required": [
              "op",
              "object_type",
              "object_id"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5
        }
      },
      "required": [
        "sentence",
        "items"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "draft_workflow",
    "description": "ارسم مسودة ورك فلو جديد: خطوات (id إنجليزي قصير، type، label، executor، permission، prompt…) ووصلات من ← إلى. ما بيتحفظ شي — بتظهر للمالك بطاقة ويفتحها بالمحرر ويراجعها ويحفظها. بداية واحدة (trigger)، وبوّابة موافقة (approval) أحمر قبل أي خطوة بتصرف أو بتغيّر شي على الحملات. ما تحط أي مبلغ أو بيانات زبون.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "trigger",
                  "step",
                  "condition",
                  "approval",
                  "wait",
                  "notify"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "executor": {
                "type": "string",
                "enum": [
                  "claude_task",
                  "claude_mcp",
                  "claude_desktop",
                  "claude_api",
                  "hermes",
                  "muse",
                  "n8n",
                  "telegram",
                  "http",
                  "person",
                  "system"
                ]
              },
              "assignee": {
                "type": "string",
                "maxLength": 40
              },
              "permission": {
                "type": "string",
                "enum": [
                  "green",
                  "yellow",
                  "red",
                  "black"
                ]
              },
              "prompt": {
                "type": "string",
                "maxLength": 8000
              },
              "inputs": {
                "type": "string",
                "maxLength": 500
              },
              "outputs": {
                "type": "string",
                "maxLength": 500
              },
              "destination": {
                "type": "string",
                "maxLength": 300,
                "description": "وين بتوصل النتيجة وعلى شو"
              },
              "desc": {
                "type": "string",
                "maxLength": 300,
                "description": "شو بيعمل هالفرع بكلام المالك"
              },
              "timeoutS": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "fallback": {
                "type": "string",
                "maxLength": 300
              },
              "target": {
                "type": "string",
                "maxLength": 200,
                "description": "الهدف لما المنفّذ n8n (اسم الـ webhook) أو http (رابط https) — الموقع بينفّذ بس من قائمتك المسموحة"
              }
            },
            "required": [
              "id",
              "type",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 30
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "maxLength": 60
              }
            },
