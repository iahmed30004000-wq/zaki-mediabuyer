[
  {
    "name": "get_numbers",
    "description": "أرقام شاشة «الأرقام» بالضبط (نفس اللي بيشوفها المالك): الصرف، الطلبات الحقيقية، تكلفة الطلب الحقيقي، المؤكد، الشحن، الأموال المتوقعة، المخزون… للمجموع ولكل منتج ولأي فترة. استعملها لأي سؤال عن رقم، وانسخ حقل display متل ما هو. المفاتيح: spend = الصرف ($) · pixelPurchases = Purchase بالبكسل · costPerPixel = تكلفة Purchase ($) · cpm = CPM ($) · ctr = CTR (%) · ordersIn = الطلبات الحقيقية · uniqueCustomers = عملاء فريدين · duplicates = تكرار انحذف · gapPct = فرق البكسل/الحقيقي (%) · costPerOrder = تكلفة الطلب الحقيقي ($) · costPerConfirmed = تكلفة المؤكد ($) · costPerDelivered = تكلفة المُسلَّم ($) · confirmed = مؤكد · rejected = مرفوض · cancelled = ملغي · waiting = بالانتظار · confirmRate = نسبة التأكيد (%) · upsellRate = نسبة الزيادة (Upsell) (%) · aov = متوسط قيمة الطلب ($) · shippedOrders = طلبات انشحنت · shippedPieces = قطع انشحنت · outForDelivery = خارجة للتوصيل · delivered = مُسلَّم · returned = مرتجع · stuck = عالق أكتر من 7 أيام · deliveryRate30 = نسبة التسليم (30 يوم) (%) · expectedRevenue = الإيراد المتوقع ($) · expectedShipping = الشحن المتوقع ($) · expectedProfit = الربح المتوقع ($) · stockUnits = القطع الباقية · stockCover = أيام التغطية (يوم)",
    "input_schema": {
      "type": "object",
      "properties": {
        "range": {
          "type": "string",
          "enum": [
            "today",
            "yesterday",
            "last7",
            "last30",
            "custom"
          ],
          "description": "today · yesterday · last7 · last30 · custom (الافتراضي today). «امبارح» = yesterday، «هالأسبوع» = last7."
        },
        "from": {
          "type": "string",
          "maxLength": 10,
          "description": "لـ custom: YYYY-MM-DD"
        },
        "to": {
          "type": "string",
          "maxLength": 10,
          "description": "لـ custom: YYYY-MM-DD (فاضي = نفس from: يوم واحد)"
        },
        "product": {
          "type": "string",
          "maxLength": 60,
          "description": "كود المنتج أو اسمه (مثلاً TIN01 أو «الطنين»). فاضي = المجموع وكل المنتجات"
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "spend",
              "pixelPurchases",
              "costPerPixel",
              "cpm",
              "ctr",
              "ordersIn",
              "uniqueCustomers",
              "duplicates",
              "gapPct",
              "costPerOrder",
              "costPerConfirmed",
              "costPerDelivered",
              "confirmed",
              "rejected",
              "cancelled",
              "waiting",
              "confirmRate",
              "upsellRate",
              "aov",
              "shippedOrders",
              "shippedPieces",
              "outForDelivery",
              "delivered",
              "returned",
              "stuck",
              "deliveryRate30",
              "expectedRevenue",
              "expectedShipping",
              "expectedProfit",
              "stockUnits",
              "stockCover"
            ]
          },
          "maxItems": 12,
          "description": "أي أرقام بالمفاتيح. فاضي = الأساسية (الصرف، الطلبات، التكلفة، المؤكد، الشحن، الربح المتوقع)"
        },
        "compare": {
          "type": "boolean",
          "description": "true = ضيف مقارنة كل رقم بالفترة اللي قبلها وبمعدّل آخر 7 أيام"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_summary",
    "description": "ملخّص أسبوع أو شهر بجواب واحد: مجموع الصرف والطلبات الحقيقية وتكلفة الطلب والمؤكد والتسليم والربح المتوقع مقابل الفترة اللي قبلها، وأرخص ثلاث منتجات وأغلى ثلاث بتكلفة الطلب الحقيقي (اللي لهم طلبات كافية بس). استعملها لـ «لخّصلي الأسبوع» و«كيف كان الشهر»، وانسخ حقل display متل ما هو.",
    "input_schema": {
      "type": "object",
      "properties": {
        "period": {
          "type": "string",
          "enum": [
            "week",
            "month"
          ],
          "description": "week = آخر 7 أيام · month = آخر 30 يوم"
        }
      },
      "required": [
        "period"
      ],
      "additionalProperties": false
    }
  },
  {
