{
  "push_metrics": {
    "type": "object",
    "properties": {
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "يوم الرقم — يوم العمل بتوقيت عمّان (Asia/Amman)، مثلاً 2026-11-14"
            },
            "level": {
              "type": "string",
              "enum": [
                "account",
                "campaign",
                "adset",
                "ad",
                "product",
                "person"
              ],
              "description": "مستوى الصف: account | campaign | adset | ad | product | person (أرقام موظف ليوم)"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "description": "رقم ميتا للعنصر (act_… أو رقم الحملة/المجموعة/الإعلان)، أو رمز المنتج لما يكون المستوى product"
            },
            "hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23,
              "description": "ساعة اللقطة (0–23) إذا الأرقام تراكمية لحد هالساعة. نفس اليوم بيتحدّث، ما بيتكرر"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "اسم العنصر كما هو بميتا"
            },
            "parent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "description": "رقم الأب: المجموعة ← حملتها، الإعلان ← مجموعته، الحملة ← حسابها"
            },
            "account_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "description": "رقم الحساب الإعلاني act_…"
            },
            "product": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "رمز المنتج (إذا ما انفهم من اسم الحملة)"
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "ACTIVE | PAUSED | …"
            },
            "budget_daily": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "الميزانية اليومية بالدولار"
            },
            "start_time": {
              "type": "string",
              "minLength": 8,
              "maxLength": 40,
              "description": "وقت بداية الصرف (ISO) — منه بتنحسب «أيام التشغيل»"
            },
            "ads_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "عدد الإعلانات (للحملة/المجموعة)"
            },
            "spend": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "الصرف بالدولار (قبل رسوم البطاقة)"
            },
            "impressions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "reach": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "link_clicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "outbound_clicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "lpv": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "مشاهدات صفحة الهبوط"
            },
            "pixel_purchases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Purchase بالبكسل (رقم ميتا — مش القرار)"
            },
            "conversations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "video_3s": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "thruplays": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "frequency": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "cpm": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "إذا ما بعت impressions، بنحسبها من الصرف والـ CPM"
            },
            "ctr": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "CTR الرابط بالمية — بيحسب النقرات إذا ما انبعتت"
            },
            "real_orders": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "الطلبات الحقيقية (هواتف فريدة) برقم هالإعلان أو المنتج بهاليوم — مستوى ad أو product بس"
            },
            "confirmed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "منها المؤكد"
            },
            "mature_orders": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "منها الناضج (مرّ عليه 24 ساعة) — للإعلان"
            },
            "shipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "delivered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "returned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "collected": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "المحصّل بالدولار من المُسلَّم"
            },
            "channel": {
              "type": "string",
              "enum": [
                "website",
                "whatsapp",
                "messenger"
              ],
              "description": "قناة الطلبات (الافتراضي website)"
            },
            "orders_in": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "طلبات الموقع الحقيقية اللي إجت بهاليوم (نفس real_orders)"
            },
            "unique_customers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "هواتف فريدة من الطلبات — الفرق عن orders_in هو التكرار المحذوف"
            },
            "rejected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "المرفوض بهاليوم"
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "الملغي بهاليوم"
            },
            "waiting": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "لسا بانتظار التأكيد (حالة وقت القراءة)"
            },
            "reject_reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  }
                },
                "required": [
                  "reason",
                  "count"
                ],
                "additionalProperties": false
              },
              "maxItems": 8,
              "description": "أكتر أسباب الرفض: [{reason, count}]"
            },
            "shipped_orders": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "الطلبات اللي انشحنت بهاليوم"
            },
            "shipped_pieces": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "مجموع الكمية (quantity) للطلبات اللي انشحنت بهاليوم"
            },
            "out_for_delivery": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "خارجة للتوصيل (حالة وقت القراءة)"
            },
            "stuck": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "عالقة أكتر من 7 أيام (حالة وقت القراءة)"
            },
            "revenue_shipped": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "مجموع totalAmount للطلبات اللي انشحنت بهاليوم"
            },
            "expected_revenue": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "إذا حسبتها عندك (الموقع بيحسب لحاله من revenue_shipped ونسبة التسليم)"
            },
            "offer_breakdown": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "offer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "description": "اسم العرض (مثلاً: قطعة، 2+هدية، 3 بسعر…)"
                  },
                  "orders": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "pieces": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000,
                    "description": "عدد القطع بالطلب الواحد من هالعرض"
                  },
                  "revenue": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000
                  }
                },
                "required": [
                  "offer",
                  "orders"
                ],
                "additionalProperties": false
              },
              "maxItems": 12,
              "description": "الطلبات لكل عرض: [{offer, orders, pieces?, revenue?}]"
            },
            "aov": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "متوسط قيمة الطلب بهاليوم"
            },
            "stock_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "القطع الباقية بالمخزون"
            },
            "claims": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "person: المسكات (الطلبات اللي مسكها)"
            },
            "no_answer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "person: ما ردّ"
            },
            "no_answer_fast": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "person: ما ردّ بأقل من دقيقة"
            },
            "first_claim_sec": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "person: سرعة أول مسكة بالثواني"
            },
            "stuck_48h": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "person: عالق فوق 48 ساعة"
            },
            "reactivated": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "person: الطلبات اللي رجّعها للحياة"
            }
          },
          "required": [
            "date",
            "level",
            "id"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 500,
        "description": "صفوف الأرقام. كل صف: التاريخ + المستوى + الرقم + أي أرقام عندك. الصف اللي فيه غلط بينرفض لحاله وباقي الصفوف بتنحفظ."
      },
      "account_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "الحساب الإعلاني act_… إذا الصفوف ما فيها account_id"
      }
    },
    "required": [
      "rows"
    ],
    "additionalProperties": false
  },
  "push_stock": {
    "type": "object",
    "properties": {
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "رمز المنتج"
            },
            "units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "القطع المتوفرة"
            },
            "days_cover": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000,
              "description": "أيام التغطية بمعدل البيع الحالي"
            },
            "as_of": {
              "type": "string",
              "minLength": 8,
              "maxLength": 40,
              "description": "وقت القراءة (ISO) — الافتراضي هلأ"
            }
          },
          "required": [
            "product",
            "days_cover"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 100,
        "description": "صف لكل منتج"
      }
    },
    "required": [
      "rows"
    ],
    "additionalProperties": false
  },
  "push_videos": {
    "type": "object",
    "properties": {
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "job": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "رقم الـ JOB"
            },
            "v_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "اسم الفيديو V…"
            },
            "product": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "رمز المنتج"
            },
            "drive_file_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "scenario_file_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "ملف سيناريو الفيديو بدرايف (03_السيناريوهات) — بيظهر رابطه على بطاقة الفيديو وبيروح مع كل طلب لهيرمز"
            },
            "meta_video_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "status": {
              "type": "string",
              "enum": [
                "bank",
                "requested",
                "ready",
                "uploaded",
                "testing",
                "winner",
                "fatigued",
                "dropped"
              ],
              "description": "bank | requested | ready | uploaded | testing | winner | fatigued | dropped"
            },
            "notes": {
              "type": "string",
              "maxLength": 300
            }
          },
          "required": [
            "job",
            "v_name",
            "product"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 300,
        "description": "صف لكل فيديو"
      }
    },
    "required": [
      "rows"
    ],
    "additionalProperties": false
  },
  "log_run": {
    "type": "object",
    "properties": {
      "job": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "description": "مفتاح الورك فلو، مثلاً daily-check أو night-round"
      },
      "ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "description": "معرّف التشغيل من عندك — لازم، ونفس المعرّف بيحدّث نفس التشغيل (استعمله لتحديثات الخطوات). بلا ref التسجيل بينرفض"
      },
      "status": {
        "type": "string",
        "enum": [
          "running",
          "ok",
          "failed",
          "waiting",
          "skipped"
        ],
        "description": "running · ok · failed · waiting · skipped — الافتراضي running. تشغيل خلص (ok/failed/skipped) ما بينفتح من جديد بـ running"
      },
      "trigger": {
        "type": "string",
        "enum": [
          "schedule",
          "manual",
          "event"
        ]
      },
      "started_at": {
        "type": "string",
        "minLength": 8,
        "maxLength": 40
      },
      "finished_at": {
        "type": "string",
        "minLength": 8,
        "maxLength": 40
      },
      "scheduled_for": {
        "type": "string",
        "minLength": 8,
        "maxLength": 40,
        "description": "الموعد اللي هالتشغيل جواب عليه (ISO) — بيربط التشغيل بموعده"
      },
      "heartbeat": {
        "type": "boolean",
        "description": "true: لسا شغّال — للتشغيل الطويل، كل 20 دقيقة"
      },
      "summary": {
        "type": "string",
        "maxLength": 300,
        "description": "سطر واحد: شو صار"
      },
      "report": {
        "type": "string",
        "maxLength": 6000,
        "description": "نص التقرير الكامل للتشغيل (لحد 6000 حرف) — بيظهر بصفحة التقرير"
      },
      "metrics": {
        "type": "object",
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "maxLength": 80
            }
          ]
        },
        "description": "أرقام التشغيل {الاسم: القيمة} (حتى 30)"
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "url": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^https:\\/\\/"
            },
            "text": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "maxItems": 10
      },
      "node": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "running",
              "done",
              "failed",
              "handoff",
              "approval",
              "skipped"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 200
          },
          "error": {
            "type": "string",
            "maxLength": 300,
            "description": "ليش فشلت الخطوة (سطر، بلا بيانات زبائن)"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false,
        "description": "حالة خطوة وحدة: {id, status: running|done|failed|waiting|handoff|approval|skipped, note, error}"
      },
      "nodes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "status": {
              "type": "string",
              "enum": [
                "waiting",
                "running",
                "done",
                "failed",
                "handoff",
                "approval",
                "skipped"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 200
            },
            "error": {
              "type": "string",
              "maxLength": 300,
              "description": "ليش فشلت الخطوة (سطر، بلا بيانات زبائن)"
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false
        },
        "maxItems": 40,
        "description": "حالة عدّة خطوات مرة وحدة"
      },
      "create_if_missing": {
        "type": "boolean",
        "description": "أنشئ الورك فلو إذا المفتاح جديد (حروف صغيرة وشرطات)"
      }
    },
    "required": [
      "job"
    ],
    "additionalProperties": false
  },
  "push_jobs": {
    "type": "object",
    "properties": {
      "jobs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,60}$",
              "description": "نفس مفتاح log_run"
            },
            "number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999,
              "description": "رقمها عالخريطة"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "domain": {
              "type": "string",
              "enum": [
                "ads",
                "ops"
              ],
              "description": "ads · ops"
            },
            "kind": {
              "type": "string",
              "enum": [
                "recurring",
                "once",
                "window",
                "manual"
              ],
              "description": "recurring متكررة · once مرة وحدة · window لفترة · manual عند الطلب"
            },
            "schedule": {
              "type": "string",
              "maxLength": 60,
              "description": "cron بخمس خانات بتوقيت عمّان"
            },
            "schedule_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "الموعد بالكلام لما ما في cron"
            },
            "runs_at": {
              "type": "string",
              "format": "date-time"
            },
            "ends_at": {
              "type": "string",
              "format": "date-time"
            },
            "runs_from": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "origin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "touches": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "maxItems": 8
            },
            "talks_to": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "maxItems": 8
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "advice": {
              "type": "string",
              "enum": [
